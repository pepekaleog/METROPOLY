@tailwind base;
@tailwind components;
@tailwind utilities;

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  background: #050505;
  color: white;
  font-family: Arial, Helvetica, sans-serif;
}

body {
  min-height: 100vh;
}

button {
  cursor: pointer;
}

::-webkit-scrollbar {
  width: 6px;
}

::-webkit-scrollbar-track {
  background: #050505;
}

::-webkit-scrollbar-thumb {
  background: #333;
  border-radius: 10px;
}

::selection {
  background: #dc2626;
  color: white;
}
